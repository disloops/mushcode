# MUSH GPT API Server Configuration
# Copy this file to mush_gpt.env and configure ALL settings below
# Server will not start without all required values configured
#
# Required packages:
#   pip install flask
#   pip install openai          (if using OpenAI)
#   pip install google-genai    (if using Gemini - NOT google-generativeai)

# =============================================================================
# ALL SETTINGS ARE REQUIRED - Server will not start without these
# =============================================================================

# LLM Provider Selection
# Must be 'openai' or 'gemini'
LLM_PROVIDER=

# API Authentication
AUTH_KEY=

# Provider Settings (set the ones that match your LLM_PROVIDER choice)

# OpenAI settings (required if LLM_PROVIDER=openai)
# Uses the modern Responses API for better performance
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Gemini settings (required if LLM_PROVIDER=gemini)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Completion Settings
MAX_COMPLETION_TOKENS=10000

# Input Limits
MAX_INPUT_LENGTH=10000

# Flask Server Settings
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=False

# Logging Settings
LOG_LEVEL=INFO
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=3
