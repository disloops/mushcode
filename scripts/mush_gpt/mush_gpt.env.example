# MUSH GPT API Server Configuration
# Copy this file to mush_gpt.env and configure ALL settings below
# Server will not start without all required values configured
#
# Required packages:
#   pip install flask
#   pip install openai          (if using OpenAI)
#   pip install google-genai    (if using Gemini - NOT google-generativeai)

# LLM Provider - must be 'openai' or 'gemini'
LLM_PROVIDER=

# API Authentication
AUTH_KEY=

# OpenAI settings (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Gemini settings (required if LLM_PROVIDER=gemini)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Completion Settings
MAX_COMPLETION_TOKENS=10000
MAX_INPUT_LENGTH=10000

# /cmd endpoint (e.g. +today) — optional; defaults shown below
# CMD_LLM_PROVIDER: openai or gemini; if unset, uses LLM_PROVIDER
# CMD_MAX_COMPLETION_TOKENS: if unset, uses MAX_COMPLETION_TOKENS (cannot exceed it)
CMD_LLM_PROVIDER=gemini
CMD_MAX_COMPLETION_TOKENS=5000

# Flask Server
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=False

# Logging
LOG_LEVEL=INFO
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=3

# Optional: Characters needing astronomical data (comma-separated)
ASTRO_CHARACTERS=

# Optional: Characters without conversation history (comma-separated)
STATELESS_CHARACTERS=
