# Starlink Bot Configuration
# Copy this file to starlink.env and configure your settings
# Also copy starlink.prompt.example to starlink.prompt and customize it!
#
# Required packages: pip install requests

# MUSH Connection
MUSH_HOST=
MUSH_PORT=
BOT_NAME=
BOT_PASSWORD=
MUSH_TIMEOUT=0.5

# API Settings
API_AUTH_KEY=
API_URL=http://localhost:5000
API_TIMEOUT=30

# LLM Provider - must be 'openai' or 'gemini'
LLM_PROVIDER=gemini

# Character Identity (for conversation buffer management)
CHARACTER_NAME=

# Bot Behavior
MESSAGE_DELAY=0.5
MAX_RETRIES=3
RETRY_DELAY=5

# Rate Limiting
RATE_LIMIT_WINDOW=60
MAX_RESPONSES_PER_WINDOW=25

# Logging
LOG_LEVEL=INFO
LOG_FILE=starlink.log

# Access Restrictions
# Set RESTRICT_USAGE=TRUE to enable location/membership checks
# When TRUE, TARGET_LOCATIONS and LOG_BOOK_DBREF become required
RESTRICT_USAGE=FALSE
TARGET_LOCATIONS=
LOG_BOOK_DBREF=

# Optional
MASTER_PLAYER_DBREF=
RESTRICTION_MESSAGE=
